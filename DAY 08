#include <iostream>
using namespace std;

int main()
{
    int i, j;

    // Q29: Half Pyramid Pattern
    cout << "Q29: Half Pyramid Pattern\n";
    for(i = 1; i <= 5; i++)
    {
        for(j = 1; j <= i; j++)
        {
            cout << "*";
        }
        cout << endl;
    }

    cout << "\n";

    // Q30: Number Triangle
    cout << "Q30: Number Triangle\n";
    for(int r = 1; r <= 5; r++)
    {
        for(int c = 1; c <= r; c++)
        {
            cout << c;
        }
        cout << endl;
    }

    cout << "\n";

    // Q31: Character Triangle
    cout << "Q31: Character Triangle\n";
    for(int row = 1; row <= 5; row++)
    {
        for(char ch = 'A'; ch < 'A' + row; ch++)
        {
            cout << ch;
        }
        cout << endl;
    }

    cout << "\n";

    // Q32: Repeated Number Pattern
    cout << "Q32: Repeated Number Pattern\n";
    for(int num = 1; num <= 5; num++)
    {
        for(int k = 1; k <= num; k++)
        {
            cout << num;
        }
        cout << endl;
    }

    return 0;
}
