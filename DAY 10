#include <iostream>
using namespace std;

int main()
{
    // Q37 Star Pyramid

    cout << "Q37\n";
    for (int i = 1; i <= 5; i++)
    {
        for (int j = 1; j <= 5 - i; j++)
            cout << " ";

        for (int j = 1; j <= (2 * i - 1); j++)
            cout << "*";

        cout << endl;
    }

    cout << endl;

    // Q38 Reverse Pyramid

    cout << "Q38\n";
    for (int i = 5; i >= 1; i--)
    {
        for (int j = 1; j <= 5 - i; j++)
            cout << " ";

        for (int j = 1; j <= (2 * i - 1); j++)
            cout << "*";

        cout << endl;
    }

    cout << endl;

    // Q39 Number Pyramid

    cout << "Q39\n";
    for (int i = 1; i <= 5; i++)
    {
        for (int j = 1; j <= 5 - i; j++)
            cout << " ";

        for (int j = 1; j <= i; j++)
            cout << j;

        for (int j = i - 1; j >= 1; j--)
            cout << j;

        cout << endl;
    }

    cout << endl;

    // Q40 Character Pyramid

    cout << "Q40\n";
    for (int i = 1; i <= 5; i++)
    {
        for (int j = 1; j <= 5 - i; j++)
            cout << " ";

        for (char ch = 'A'; ch < 'A' + i; ch++)
            cout << ch;

        for (char ch = 'A' + i - 2; ch >= 'A'; ch--)
            cout << ch;

        cout << endl;
    }

    return 0;
}
