#include <iostream>
using namespace std;

int main()
{
    string name;
    int age;

    cout << "Enter your name: ";
    cin >> name;

    cout << "Enter your age: ";
    cin >> age;

    if (age >= 18)
    {
        cout << name << " is eligible to vote.";
    }
    else
    {
        cout << name << " is not eligible to vote.";
    }

    return 0;
}
