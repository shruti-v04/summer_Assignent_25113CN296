#include <iostream>
using namespace std;

int main()
{
    int empId;
    char name[50];
    float basic, hra, da, gross;

    cout << "Enter Employee ID: ";
    cin >> empId;

    cin.ignore();

    cout << "Enter Employee Name: ";
    cin.getline(name, 50);

    cout << "Enter Basic Salary: ";
    cin >> basic;

    hra = basic * 0.20;
    da = basic * 0.10;
    gross = basic + hra + da;

    cout << "\nSalary Details\n";
    cout << "Employee ID : " << empId << endl;
    cout << "Name        : " << name << endl;
    cout << "Basic Salary: " << basic << endl;
    cout << "HRA         : " << hra << endl;
    cout << "DA          : " << da << endl;
    cout << "Gross Salary: " << gross << endl;

    return 0;
}
