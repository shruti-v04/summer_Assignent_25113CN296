#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    // Q13: Generate Fibonacci series
    int n, first = 0, second = 1, next;
    cout << "Enter number of terms for Fibonacci series: ";
    cin >> n;
    
    cout << "Fibonacci series: ";
    for (int i = 0; i < n; i++) {
        if (i <= 1) {
            next = i;
        } else {
            next = first + second;
            first = second;
            second = next;
        }
        cout << next << " ";
    }
    cout << endl;

    // Q14: Find nth Fibonacci term
    int n_term, first_ft = 0, second_ft = 1, next_ft;
    cout << "\nEnter n for nth Fibonacci term: ";
    cin >> n_term;
    
    if (n_term <= 0) {
        cout << "Please enter a positive integer" << endl;
    } else if (n_term == 1) {
        cout << "The " << n_term << "th Fibonacci term is " << first_ft << endl;
    } else if (n_term == 2) {
        cout << "The " << n_term << "nd Fibonacci term is " << second_ft << endl;
    } else {
        for (int i = 3; i <= n_term; i++) {
            next_ft = first_ft + second_ft;
            first_ft = second_ft;
            second_ft = next_ft;
        }
        cout << "The " << n_term << "th Fibonacci term is " << second_ft << endl;
    }

    // Q15: Check Armstrong number
    int num, temp, remainder, sum = 0, digits = 0;
    cout << "\nEnter a number to check Armstrong: ";
    cin >> num;
    
    temp = num;
    
    // Count digits
    while (temp > 0) {
        digits++;
        temp /= 10;
    }
    
    temp = num;
    
    // Calculate sum of digits raised to power of digit count
    while (temp > 0) {
        remainder = temp % 10;
        sum += pow(remainder, digits);
        temp /= 10;
    }
    
    if (num == sum) {
        cout << num << " is an Armstrong number" << endl;
    } else {
        cout << num << " is not an Armstrong number" << endl;
    }

    // Q16: Print Armstrong numbers in a range
    int lower, upper, temp_ar, remainder_ar, sum_ar, digits_ar;
    cout << "\nEnter lower limit for Armstrong range: ";
    cin >> lower;
    cout << "Enter upper limit for Armstrong range: ";
    cin >> upper;
    
    cout << "Armstrong numbers between " << lower << " and " << upper << " are: ";
    
    for (int i = lower; i <= upper; i++) {
        if (i <= 0) continue;
        
        temp_ar = i;
        sum_ar = 0;
        digits_ar = 0;
        
        // Count digits
        while (temp_ar > 0) {
            digits_ar++;
            temp_ar /= 10;
        }
        
        temp_ar = i;
        
        // Calculate sum
        while (temp_ar > 0) {
            remainder_ar = temp_ar % 10;
            sum_ar += pow(remainder_ar, digits_ar);
            temp_ar /= 10;
        }
        
        if (i == sum_ar) {
            cout << i << " ";
        }
    }
    cout << endl;

    return 0;
}
